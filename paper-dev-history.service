[Unit]
Description=Developer history paper trading simulator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ai-bot
Environment=PYTHONPATH=/root/ai-bot/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/ai-bot/.venv/bin/python -u run_paper_dev_history.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
