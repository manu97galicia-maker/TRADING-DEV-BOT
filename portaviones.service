[Unit]
Description=PORTAVIONES - copia 8 wallets, entrada MC menor de 4K
After=network-online.target
Wants=network-online.target
# Igual que dev10: sin esto systemd se rinde tras 5 arranques en 10 s y deja el
# servicio en `failed` para siempre.
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/ai-bot
Environment=PYTHONPATH=/root/ai-bot/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/ai-bot/.venv/bin/python -u run_portaviones.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
