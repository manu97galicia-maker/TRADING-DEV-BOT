SOLANA_NODE_RPC_ENDPOINT=...
SOLANA_NODE_WSS_ENDPOINT=...

GEYSER_ENDPOINT=
GEYSER_API_TOKEN=
GEYSER_AUTH_TYPE=x-token or basic

# --- Optional market-data providers ---
# DexScreener is public and does not need a key.
BIRDEYE_API_KEY=
DEXTOOLS_API_KEY=
# DEXTools keys are tied to an API tier (trial, standard, advanced, or pro).
DEXTOOLS_API_TIER=trial

SOLANA_PRIVATE_KEY=

# --- Telegram ---
# Son DOS credenciales distintas y hacen cosas distintas. Hace falta tener
# las dos: con una sola, o no lees los canales, o no recibes los avisos.
#
# 1) LEER canales (MoonTok, DEXTools Nitro). Es tu cuenta personal, y las
#    claves salen de https://my.telegram.org. Ademas hay que hacer un login
#    de una sola vez con el telefono:
#       uv run learning-examples/autorizar_telegram.py
#    Eso crea el fichero de sesion; sin el, las fuentes de Telegram arrancan
#    mudas y lo avisan en el log.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
#
# 2) ENVIAR los avisos de compra y venta. Esto es un bot de @BotFather, no
#    tu cuenta. El CHAT_ID es donde quieres recibirlos: escribele al bot y
#    mira https://api.telegram.org/bot<TU_TOKEN>/getUpdates para sacarlo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (fuente desactivada por defecto) ---
DISCORD_TOKEN=

# --- Dashboard (python -m dashboard, http://127.0.0.1:8787) ---
# The associated wallet is the one derived from SOLANA_PRIVATE_KEY above:
# the SAME wallet the bot trades with. The dashboard shows its address and
# balance in the Wallet panel. Deposit = send SOL to that address.
#
# Set to true to ENABLE real SOL withdrawals from the dashboard. Off by
# default. Only ever accepts requests from localhost (127.0.0.1).
DASHBOARD_ALLOW_WITHDRAW=false
# DASHBOARD_PORT=8787
#
# Remote access (e.g. from your phone over Tailscale):
#   DASHBOARD_HOST=0.0.0.0  -> bind on the LAN/VPN address (default 127.0.0.1)
# Login for remote control (localhost never needs it). Withdraw + wallet
# import stay PC-only regardless. Leave unset to disable remote control.
# DASHBOARD_HOST=127.0.0.1
DASHBOARD_USER=
DASHBOARD_PASSWORD=
