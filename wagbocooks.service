[Unit]
Description=Wagbocooks Telegram instant Pump.fun strategy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/ai-bot
Environment=PYTHONPATH=/root/ai-bot/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/ai-bot/.venv/bin/python -u run_wagbocooks.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
